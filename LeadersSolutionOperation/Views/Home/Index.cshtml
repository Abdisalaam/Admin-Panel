@{
    ViewBag.Title = "Leaders Solutions – Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="row align-items-center mb-5">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold">Welcome to Leaders Solutions</h1>
            <p class="lead text-muted">
                Empowering digital transformation through innovative IT solutions, enterprise systems,
                and secure technology services tailored for modern organizations.
            </p>
        </div>
        <div class="col-md-5 text-center">
            <img src="@Url.Content("~/Asset/images/cmp/IT.jpg")" class="img-fluid" loading="lazy" alt="LS Technology">
        </div>
    </div>

    <hr />

    <!-- Services Section -->
    <div class="row text-center mt-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="fw-bold">Enterprise Projects</h3>
                <p class="text-muted">
                    Delivering high‑impact IT and business projects for government and private sectors,
                    including GSTC, ZATCA, and NEOM.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="fw-bold">Technology Solutions</h3>
                <p class="text-muted">
                    Secure, scalable, and modern solutions powered by the latest technology 
                    innovations and enterprise‑grade architectural standards.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 h-100">
                <h3 class="fw-bold">Professional Services</h3>
                <p class="text-muted">
                    Project management, PMO leadership, branding, communication, and technical consulting
                    tailored to organizational needs.
                </p>
            </div>
        </div>
    </div>  

</div>
