@model IEnumerable<LeadersSolutionOperation.Models.ContactUs>

@{
    ViewBag.Title = "List of Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <h2 class="mb-3">List of Request / Contact Applications</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Mobile)</th>
                            <th>@Html.DisplayNameFor(model => model.Service)</th>
                            <th>@Html.DisplayNameFor(model => model.Comment)</th>
                            <th>@Html.DisplayNameFor(model => model.ContactedDate)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(m => item.Name)</td>
                                <td>

                                    @Html.DisplayFor(m => item.Email)
                                </td>
                                <td>@Html.DisplayFor(m => item.Mobile)</td>
                                <td>@Html.DisplayFor(m => item.Service)</td>
                                <td>
                                    <span title="@item.Comment">@(item.Comment?.Length > 6 ? item.Comment.Substring(0, 6) + "..." : item.Comment)</span>
                                    @*@Html.DisplayFor(m => item.Comment)*@
                                </td>

                                <td>
                                    @Html.DisplayFor(m => item.ContactedDate)

                                </td>

                                <td class="actions-cell">
                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a href="@Url.Action("Delete", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var message = "@ViewBag.Message";
            if (message) {
                Snackbar.show({
                    text: message,
                    pos: 'top-center'
                });
            }
        });
    </script>
}
