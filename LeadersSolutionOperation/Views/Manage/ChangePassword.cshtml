@model LeadersSolutionOperation.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="row w-100">
        <div class="col-md-6 col-lg-5 mx-auto">

           
            <h4 class="text-center mb-4">Change Password</h4>

            @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })

                <!-- Old Password -->
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.OldPassword)
            <div class="input-group">
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", id = "OldPassword" })
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('OldPassword')">
                    <i class="fa fa-eye eye-icon"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })

        </div>

                <!-- New Password -->
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.NewPassword)
            <div class="input-group">
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", id = "NewPassword" })
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('NewPassword')">
                    <i class="fa fa-eye eye-icon"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })

        </div>

                <!-- Confirm Password -->
        <div class="form-group mb-4">
            @Html.LabelFor(m => m.ConfirmPassword)
            <div class="input-group">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", id = "ConfirmPassword" })
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmPassword')">
                    <i class="fa fa-eye eye-icon"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })

        </div>

                <button type="submit" class="btn btn-outline-dark w-100">Change password</button>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function togglePassword(id) {
            var input = document.getElementById(id);
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }
    </script>
}
